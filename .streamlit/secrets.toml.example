# Copy this into Streamlit Community Cloud's "Secrets" editor (App settings -> Secrets),
# or save locally as .streamlit/secrets.toml for local Streamlit-specific testing.
# Local CLI usage reads from .env instead (see .env.example) — this file is Streamlit-only.

OPENAI_API_KEY = "sk-..."
OPENAI_MODEL = "gpt-4o-mini"
EMBEDDING_MODEL = "text-embedding-3-small"
SEC_USER_AGENT = "FinanceAgent contact@example.com"
CHROMA_PERSIST_DIR = ".chroma"
LOG_LEVEL = "INFO"
